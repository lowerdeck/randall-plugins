{
  "name": "@randall-plugins/map-editor",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "module": "./dist/esm/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.prod.json --module es2022 --outDir dist/esm --declarationDir dist/types",
    "build:cjs": "tsc -p tsconfig.prod.json --module commonjs --outDir dist/cjs --declaration false --declarationMap false",
    "check": "tsc -p . --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@randall-plugins/map": "workspace:*",
    "@randall/plugin-sdk": "workspace:*",
    "@randall/plugin-sdk-editor": "workspace:*",
    "maplibre-gl": "~5.6.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "@types/lodash": "^4.17.20"
  }
}
