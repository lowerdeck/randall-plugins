{
  "compilerOptions": {
    "target": "ES2022",
    "moduleResolution": "node",
    "isolatedModules": true,
    "jsx": "react-jsx",

    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,

    "strict": true,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "useDefineForClassFields": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  }
}
